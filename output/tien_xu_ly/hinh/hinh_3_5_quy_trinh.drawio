<mxfile host="app.diagrams.net"><diagram name="Tien xu ly BG20"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="1" pageWidth="720" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g0" value="Chuẩn bị trước huấn luyện" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#999999;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontFamily=Times New Roman;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="8" y="30" width="672" height="285" as="geometry"/></mxCell><mxCell id="g1" value="Khi nạp dữ liệu" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#999999;horizontal=0;verticalAlign=top;align=center;spacingTop=2;fontFamily=Times New Roman;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="8" y="345" width="672" height="100" as="geometry"/></mxCell><mxCell id="kv" value="Kvasir-SEG&#xa;1.000 ảnh polyp và mặt nạ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="50" as="geometry"/></mxCell><mxCell id="nc" value="Kvasir, lớp normal-cecum&#xa;1.000 ảnh không có polyp" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="50" width="260" height="50" as="geometry"/></mxCell><mxCell id="cv" value="Chuyển mặt nạ thành đa giác&#xa;Otsu → phép đóng → đường bao&#xa;→ đơn giản hóa → chuẩn hóa tọa độ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="70" as="geometry"/></mxCell><mxCell id="bg" value="Chọn ngẫu nhiên 200 ảnh, seed 42&#xa;Chia 160 huấn luyện / 40 kiểm định&#xa;Tạo tệp nhãn rỗng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#555555;fontFamily=Times New Roman;fontSize=